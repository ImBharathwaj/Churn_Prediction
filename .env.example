# --- Database ---
DATABASE_URL=postgresql+asyncpg://scraper:scraper@localhost:5433/scraper

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Scraper config ---
# Comma-separated list of sources to use. Available: google_maps, google_places, yellowpages
SCRAPER_SOURCES=google_maps,yellowpages

# Max results per source per query
MAX_RESULTS_PER_SOURCE=30

# Per-request timeout (seconds)
REQUEST_TIMEOUT=30

# Headless mode for Playwright (true/false). Set to false to watch the browser.
PLAYWRIGHT_HEADLESS=true

# --- Optional: Google Places API (recommended, ToS-compliant) ---
# Get one at https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=

# --- Optional: User agent override for static scrapers ---
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
